# Recommended: Ankr Advanced API (single call → all chains + all tokens)
# https://www.ankr.com/rpc/ → Advanced API key
ANKR_API_KEY=

# Optional fallback: Moralis Wallet API
# https://admin.moralis.io/
MORALIS_API_KEY=

# Optional: dedicated Solana RPC (Helius/QuickNode/etc).
# Default: https://api.mainnet-beta.solana.com
# Do not point this at Ankr Advanced API keys — they often 403 on /solana.
SOLANA_RPC_URL=

# Optional: TronGrid API key for higher rate limits
TRONGRID_API_KEY=

# BOT Chain tip unlock (product defaults are in src/lib/botchain/config.ts)
# Tip amount: 0.3 BOT → 0x9B4d9039A96Bfd7320C865aaCC69F35b51f425a7
# For local tip smoke tests only — never commit real keys:
# BOT_TEST_PK=
